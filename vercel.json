{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/dashboard" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ],
  "functions": {
    "api/neighborhood-results.js": { "maxDuration": 60 },
    "api/polling-places.js": { "maxDuration": 60 }
  }
}
